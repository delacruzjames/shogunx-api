{
  "name": "shogunx-api",
  "description": "ShogunX Rails API",
  "stack": "container",
  "env": {
    "RAILS_ENV": "production",
    "RAILS_LOG_LEVEL": "info",
    "OPENAI_MODEL": "gpt-4o-mini",
    "SOLID_QUEUE_IN_PUMA": "true"
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    "heroku-postgresql:essential-0"
  ]
}
