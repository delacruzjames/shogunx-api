# API key MT4 EA (and other clients) must send as X-ShogunX-Api-Key
SHOGUNX_API_KEY=dev-secret-change-me

# Trading mode: conservative (default) | tactical
# conservative — require D1, H4, and H1 trend alignment for BUY/SELL
# tactical — daily trader: infer H4/H1 setups when Brain returns WAIT (-10 if D1 disagrees)
# SHOGUNX_TRADING_MODE=tactical
#
# MT4 EA: set IntervalSeconds=3600 (1 hour) for daily analysis cadence
# Take-profit legs (pips): SHOGUNX_TP_PIPS=20,30,40
# Entry S/R timeframe: SHOGUNX_ENTRY_TIMEFRAME=H1 (tactical defaults to H1, conservative to H4)
# Max entry distance in tactical mode: SHOGUNX_MAX_ENTRY_PIPS=40

# OpenAI — required for live analysis (OpenaiAnalysisService). Not OPEN_API_KEY.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ForexFactory economic calendar (NewsFilterService)
# FOREXFACTORY_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# NewsSyncJob refreshes economic_events every 15 minutes via Solid Queue.
# SOLID_QUEUE_IN_PUMA=true

# Production (Heroku) — set in Heroku config vars, not in .env
# DATABASE_URL=          # auto from Heroku Postgres
# RAILS_MASTER_KEY=      # from config/master.key
# RAILS_HOST=            # e.g. shogunx-api.herokuapp.com
# CORS_ORIGINS=          # e.g. https://your-dashboard.vercel.app
