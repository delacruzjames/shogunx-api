# Copy to your shell or CI secrets. Do not commit real values.
#
# AWS (set before running deploy/aws/*.sh)
export AWS_REGION=us-east-1
export AWS_ACCOUNT_ID=123456789012
export ECR_REPOSITORY=shogunx-api
export ECS_CLUSTER=shogunx-api
export ECS_SERVICE=shogunx-api-web
export ECS_TASK_DEFINITION_FAMILY=shogunx-api
#
# Networking (required for migrate.sh)
export ECS_SUBNETS=subnet-aaa,subnet-bbb
export ECS_SECURITY_GROUPS=sg-ecs-tasks
#
# IAM role ARNs (create in AWS console / IaC first)
export ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/shogunx-api-ecs-execution-role
export ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/shogunx-api-ecs-task-role
#
# Secrets Manager ARNs (append the random suffix AWS adds, e.g. -AbCdEf)
export SECRET_RAILS_MASTER_KEY_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:shogunx-api/rails-master-key
export SECRET_DATABASE_URL_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:shogunx-api/database-url
export SECRET_OPENAI_API_KEY_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:shogunx-api/openai-api-key
export SECRET_SHOGUNX_API_KEY_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:shogunx-api/shogunx-api-key
#
# Plain environment (set in task definition or ECS console)
export RAILS_HOST=api.example.com
export CORS_ORIGINS=https://your-dashboard.vercel.app
export OPENAI_MODEL=gpt-4o-mini
export FOREXFACTORY_SYNC_ON_FILTER=true
